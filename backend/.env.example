# Airtable credentials (never expose these to the frontend)
AIRTABLE_API_KEY=patxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Server
PORT=4000

# Frontend origin allowed by CORS
FRONTEND_ORIGIN=http://localhost:3000

# Email (EmailJS) — required for proposal submit
# https://dashboard.emailjs.com
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx
# Private key recommended for server-side sends (Account → General)
EMAILJS_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxx
EMAILJS_OWNER_TEMPLATE_ID=template_xxxxxxx
EMAILJS_CLIENT_TEMPLATE_ID=template_xxxxxxx
# Your inbox for new proposal notifications
OWNER_EMAIL=you@example.com
